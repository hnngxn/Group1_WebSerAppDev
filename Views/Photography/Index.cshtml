@model List<Group1_WebSerAppDev.Models.Photo>
@{
    ViewData["Title"] = "Photography";
}

<div class="text-center my-5">
    <h1 class="display-5">Photography</h1>
    <p class="lead mx-auto" style="max-width: 700px;">
        I'm a nostalgia person. I take photos because I want to live those moments again later,
        so I mostly shoot people going about their day, usually without them noticing.
        I like when a photo feels like a scene from a movie.
    </p>
</div>

<div class="row g-3 mb-4">
    @foreach (var p in Model)
    {
        <div class="col-6 col-md-4">
            <img src="/images/photography/@p.ImageFile" class="img-fluid rounded shadow-sm gallery-img" alt="@p.Title">
            <p class="small text-muted mt-1 mb-0">@p.Title · @p.Location</p>
        </div>
    }
</div>

<div class="text-center mb-5">
    <a asp-action="Photos" class="btn btn-dark">See my photo log</a>
</div>