@{
    ViewData["Title"] = "Home";
}

<section class="bg-dark text-white rounded-3 px-4 px-md-5 py-5 mb-5">
    <h1 class="display-5 fw-bold">Team Hobbies</h1>
    <p class="lead mb-4" style="max-width: 640px;">
        We're Han, Van and Alex. We each have a hobby that we love and want to share with others.
    </p>
    <a asp-controller="About" asp-action="Index" class="btn btn-outline-light">About us</a>
</section>

<h2 class="h4 mb-4">Our hobbies</h2>
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm hobby-card">
            <div class="card-body d-flex flex-column">
                <h3 class="h5 card-title mb-1">Photography</h3>
                <p class="text-muted small mb-3">Han Nguyen</p>
                <p class="card-text">
                    Han's photos from Cincinnati, Hershey Park, DC and Vietnam, plus a photo log
                    with where and when each one was taken.
                </p>
                <a asp-controller="Photography" asp-action="Index" class="btn btn-dark mt-auto align-self-start stretched-link">View photography</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm hobby-card">
            <div class="card-body d-flex flex-column">
                <h3 class="h5 card-title mb-1">Rollerblading</h3>
                <p class="text-muted small mb-3">Alex Prager</p>
                <p class="card-text">
                    Why rollerblading is a good workout, and a table comparing it with running,
                    cycling, swimming and other cardio.
                </p>
                <a asp-controller="Rollerblading" asp-action="Index" class="btn btn-dark mt-auto align-self-start stretched-link">View rollerblading</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h3 class="h5 card-title mb-1">Weightlifting</h3>
                <p class="text-muted small mb-3">Van Diep</p>
                <p class="card-text">
                    Van's section is still being built.
                </p>
                @* Swap this for a link to the Weightlifting controller once that page is merged. *@
                <span class="btn btn-outline-secondary mt-auto align-self-start disabled">Coming soon</span>
            </div>
        </div>
    </div>
</div>
