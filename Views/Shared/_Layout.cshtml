<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Team Hobbies</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Group1_WebSerAppDev.styles.css" asp-append-version="true" />
</head>
<body>
   
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        var isHome = controller == "Home" && action == "Index";
        var isAbout = controller == "About";
        var isPhotography = controller == "Photography";
        var isRollerblading = controller == "Rollerblading";
        var isPrivacy = controller == "Home" && action == "Privacy";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark site-nav mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Team Hobbies</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")" aria-current="@(isHome ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAbout ? "active" : "")" aria-current="@(isAbout ? "page" : null)" asp-area="" asp-controller="About" asp-action="Index">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPhotography ? "active" : "")" aria-current="@(isPhotography ? "page" : null)" asp-area="" asp-controller="Photography" asp-action="Index">Photography</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isRollerblading ? "active" : "")" aria-current="@(isRollerblading ? "page" : null)" asp-area="" asp-controller="Rollerblading" asp-action="Index">Rollerblading</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPrivacy ? "active" : "")" aria-current="@(isPrivacy ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer site-footer">
        <div class="container">
            &copy; 2026 - Team Hobbies - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>